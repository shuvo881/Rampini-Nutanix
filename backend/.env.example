# Copy this file to .env and fill in your Nutanix NAI values.
# Do not commit .env to source control.

# Media
MEDIA_DIR=media
RAG_DOCS_DIR=${MEDIA_DIR}/rag_docs

# NAI
NAI_ENDPOINT=https://your-endpoint
NAI_API_KEY=your-api-key
EMBED_MODEL=your-embedding-model
CHAT_MODEL=your-chat-model

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_DATABASE=test
MILVUS_COLLECTION=test_collection4